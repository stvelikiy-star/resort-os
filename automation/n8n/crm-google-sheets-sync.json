      "id": "c4b23008-20c3-45d1-a5db-001000000002",
      "name": "Fetch CRM Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-800, 0]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nif (d.source_of_truth !== 'RESORT_CORE') throw new Error('CRM feed source-of-truth contract failed');\nfor (const key of ['requests','reservations','payments']) {\n  if (!d[key] || !Array.isArray(d[key].items)) throw new Error(`CRM feed missing ${key}.items`);\n  if (d[key].truncated) throw new Error(`CRM feed ${key} is truncated at the current 1000-row safety limit; switch to incremental high-water sync before publishing this workflow again.`);\n}\nreturn [{ json: d }];"
      },
      "id": "c4b23008-20c3-45d1-a5db-001000000003",
      "name": "Validate CRM Feed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Validate CRM Feed').item.json.requests.items ?? [];\nconst channel = (v) => {\n  const x = String(v ?? '').toUpperCase();\n  if (x.includes('INSTAGRAM')) return 'Instagram';\n  if (x.includes('WHATSAPP')) return 'WhatsApp';\n  if (x.includes('TELEGRAM')) return 'Telegram';\n  if (x.includes('WEB') || x.includes('SITE')) return 'Сайт';\n  if (x.includes('PHONE')) return 'Телефон';\n  if (x.includes('WALK')) return 'Walk-in';\n  if (x.includes('PARTNER')) return 'Партнер';\n  return 'Другое';\n};\nconst status = (v) => ({ NEW:'Новый', QUOTED:'В работе', AWAITING_PREPAYMENT:'Ждет ответ', CONVERTED:'Бронь создана', CANCELLED:'Закрыт', REJECTED:'Нецелевой', EXPIRED:'Закрыт' }[v] ?? 'В работе');\nreturn rows.map((r) => ({ json: {\n  'Lead ID': r.lead_id,\n  'Дата/время': r.created_at,\n  'Канал': channel(r.channel),\n  'Имя': r.guest_name,\n  'Телефон': r.phone,\n  'Контакт/ник': r.email ?? '',\n  'Заезд': r.check_in,\n  'Выезд': r.check_out,\n  'Ночей': r.nights,\n  'Гостей': Number(r.adults ?? 0) + Number(r.children ?? 0),\n  'Дети': r.children ?? 0,\n  'Тип номера': r.room_type_name ?? r.room_type_code ?? '',\n  'Бюджет KGS': r.quoted_total_kgs ?? '',\n  'Статус': status(r.status),\n  'Последний контакт': r.updated_at,\n  'Источник/кампания': channel(r.channel),\n  'Комментарий': r.notes ?? '',\n  'Booking ID': r.booking_id ?? ''\n} }));"
      },
