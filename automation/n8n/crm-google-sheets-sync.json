    {
      "parameters": {
        "jsCode": "const rows = $('Validate CRM Feed').item.json.reservations.items ?? [];\nconst bookingStatus = (v) => ({ GUARANTEED:'CONFIRMED', CONFIRMED:'CONFIRMED', CHECKED_IN:'CHECKED_IN', CHECKED_OUT:'CHECKED_OUT', CANCELLED:'CANCELLED', PENDING_PAYMENT:'PENDING_PAYMENT' }[v] ?? String(v ?? ''));\nconst paymentStatus = (r) => Number(r.received_kgs ?? 0) <= 0 ? 'Не оплачено' : Number(r.outstanding_kgs ?? 0) > 0 ? 'Частично' : 'Оплачено';\nreturn rows.map((r) => ({ json: {\n  'Booking ID': r.booking_id,\n  'Lead ID': r.lead_id ?? '',\n  'Дата создания': r.created_at,\n  'Гость': r.guest_name ?? '',\n  'Телефон': r.phone ?? '',\n  'Заезд': r.check_in,\n  'Выезд': r.check_out,\n  'Ночей': r.nights,\n  'Гостей': Number(r.adults ?? 0) + Number(r.children ?? 0),\n  'Сумма': r.total_kgs,\n  'Оплачено KGS': r.received_kgs,\n  'Остаток KGS': r.outstanding_kgs,\n  'Статус брони': bookingStatus(r.status),\n  'Статус оплаты': paymentStatus(r)\n} }));"
      },
