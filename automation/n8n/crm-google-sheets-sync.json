    {
      "parameters": {
        "jsCode": "const rows = $('Validate CRM Feed').item.json.payments.items ?? [];\nconst paymentStatus = (v) => ({ RECEIVED:'Оплачено', PENDING:'Не оплачено', REFUNDED:'Возврат', FAILED:'Ошибка', CANCELLED:'Ошибка' }[v] ?? 'Не оплачено');\nconst method = (v) => {\n  const x = String(v ?? '').toUpperCase();\n  if (x.includes('MBANK')) return 'MBank';\n  if (x.includes('OPTIMA')) return 'Optima';\n  if (x.includes('PAYBOX')) return 'PayBox';\n  if (x.includes('CASH')) return 'Наличные';\n  if (x.includes('CARD') || x.includes('POS')) return 'Карта/POS';\n  if (x.includes('BANK') || x.includes('TRANSFER')) return 'Банковский перевод';\n  return 'Другое';\n};\nreturn rows.map((r) => ({ json: {\n  'Payment ID': r.payment_id,\n  'Booking ID': r.booking_id ?? '',\n  'Дата': r.paid_at ?? r.created_at,\n  'Гость': r.guest_name ?? '',\n  'Сумма KGS': r.amount_kgs,\n  'Валюта': 'KGS',\n  'Метод': method(r.method),\n  'Статус': paymentStatus(r.status),\n  'Референс/транзакция': r.external_ref ?? '',\n  'Комментарий': r.provider ? `Core provider: ${r.provider}` : ''\n} }));"
      },
