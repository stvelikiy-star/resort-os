# Copy to .env.marina-production on the Ubuntu host; chmod 600; never commit secrets.
# Values marked CHANGE_ME are deliberately rejected by marina_production_preflight.py.

APP_ENV=production
MARINA_INSTANCE_SLUG=CHANGE_ME_UNIQUE_HOTEL_SLUG
MARINA_HOST_ROOT=/srv/marina-smart/CHANGE_ME_UNIQUE_HOTEL_SLUG
MARINA_HOST_DATA_DIR=/srv/marina-smart/CHANGE_ME_UNIQUE_HOTEL_SLUG/data
MARINA_RELEASE_SHA=UNSET

# Dedicated hotel domain and service subdomains. DNS A/AAAA records point to this host.
MARINA_PUBLIC_HOST=hotel.example.invalid
MARINA_ADMIN_HOST=admin.hotel.example.invalid
MARINA_STAFF_HOST=staff.hotel.example.invalid
MARINA_API_HOST=api.hotel.example.invalid
MARINA_AUTOMATION_HOST=automation.hotel.example.invalid
TLS_EMAIL=CHANGE_ME_OWNER_EMAIL

# Each hotel has its own database, network, host data directory and Compose project.
# Use 32+ chars from A-Z, a-z, 0-9, _ or - so DATABASE_URL stays correctly encoded.
MARINA_POSTGRES_DB=marina_CHANGE_ME
MARINA_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_32_CHAR_DATABASE_SECRET
PROPERTY_CODE=CHANGE_ME_PROPERTY_CODE
MARINA_PROPERTY_NAME=CHANGE_ME_HOTEL_NAME
MARINA_TENANT_CODE=CHANGE_ME_TENANT_CODE
MARINA_TIMEZONE=Asia/Bishkek
MARINA_CURRENCY=KGS
RATE_PLAN_CODE=DIRECT
MARINA_TENANT_CONTEXT_ENABLED=false

# Supply owner credentials only in the operator's protected shell environment for
# the one-time bootstrap. Keep these values out of this file.
MARINA_PROVISION_CONFIRM=
MARINA_OWNER_USERNAME=
MARINA_OWNER_PASSWORD=
MARINA_OWNER_DISPLAY_NAME=Owner

# Independent secrets. Generate each separately; do not reuse one secret.
AUTOMATION_SERVICE_KEY=CHANGE_ME_AUTOMATION_SERVICE_KEY_AT_LEAST_32_CHARS
N8N_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_N8N_ENCRYPTION_KEY_AT_LEAST_32_CHARS
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_PUBLIC_ASSISTANT_MODEL=
OPENAI_WHATSAPP_MODEL=
OPENAI_SALES_MODEL=
OPENAI_TRANSCRIBE_MODEL=

# Optional channel integrations remain disabled until real credentials are approved.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
TELEGRAM_STAFF_WEBHOOK_SECRET=
TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_WEBHOOK_SECRET=
TELEGRAM_SALES_CHANNEL_CODE=TELEGRAM_SALES
TELEGRAM_SALES_DISPLAY_NAME=Telegram Sales
TELEGRAM_SALES_ACCOUNT_ID=
TELEGRAM_PROVIDER_TIMEOUT_SECONDS=10
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_WEBHOOK_SECRET=
ENABLE_PAYMENT_OPERATIONS=false
ENABLE_MKASSA=false
ENABLE_SERVICE_POINT_QR=false

N8N_IMAGE=n8nio/n8n:2.37.10
SESSION_TTL_HOURS=12
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_PAIR_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=30
REQUIRE_AUTOMATION_SERVICE=true
LAUNCH_PROFILE=FULL_NO_PAYMENTS

# Production requires a separate off-site object-storage prefix per hotel.
# The general backup script defaults to Three Crowns; set every value below explicitly.
OFFSITE_BACKUP_REQUIRED=true
S3_ENDPOINT_URL=CHANGE_ME_HTTPS_OBJECT_STORAGE_ENDPOINT
S3_REGION=CHANGE_ME_STORAGE_REGION
S3_BACKUP_BUCKET=CHANGE_ME_PRIVATE_BUCKET
S3_BACKUP_PREFIX=marina/CHANGE_ME_UNIQUE_HOTEL_SLUG
S3_ACCESS_KEY_ID=CHANGE_ME_DEDICATED_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_DEDICATED_SECRET_KEY_AT_LEAST_32_CHARS
RETENTION_DAYS=14
