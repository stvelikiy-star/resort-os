# Three Crowns Beget target environment.
# Copy to .env.production only on the Beget VPS after staging acceptance.
# Never commit real credentials or production secrets.

APP_ENV=production
# Exact accepted 40-character Git commit used to build api/web/admin/staff images.
RELEASE_SHA=CHANGE_ME_EXACT_40_CHAR_GIT_SHA

# --- Public TLS names ---
PUBLIC_HOST=3korony.com
ADMIN_HOST=admin.3korony.com
STAFF_HOST=staff.3korony.com
API_HOST=api.3korony.com
AUTOMATION_HOST=automation.3korony.com
TLS_EMAIL=CHANGE_ME_OWNER_EMAIL

HOST_DATA_DIR=/srv/three-crowns/data

# --- Beget PostgreSQL DBaaS ---
# Use the private DB endpoint/network where Beget makes it available.
# URL-encode reserved characters in username/password.
# Managed production transport must retain its TLS requirement.
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@CHANGE_ME_PRIVATE_DB_HOST:5432/resort_os?sslmode=require
# pg_dump/libpq URL. Keep sslmode, but do not add Prisma-only schema= here.
PG_DUMP_DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@CHANGE_ME_PRIVATE_DB_HOST:5432/resort_os?sslmode=require
DB_BACKUP_MODE=url

PROPERTY_CODE=THREE_CROWNS
RATE_PLAN_CODE=DIRECT_2026_27
EXPECTED_ROOM_COUNT=84
EXPECTED_ROOM_TYPE_COUNT=12
REQUIRE_MIGRATION_HISTORY=true
REQUIRE_RECENT_BACKUP=true
LAST_VERIFIED_BACKUP_AT=
MAX_BACKUP_AGE_HOURS=24

CORS_ORIGINS=https://3korony.com,https://admin.3korony.com,https://staff.3korony.com
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
REQUIRE_COOKIE_DOMAIN=false
COOKIE_DOMAIN=

AUTOMATION_SERVICE_KEY=CHANGE_ME_LONG_RANDOM_SERVICE_KEY_AT_LEAST_32_CHARS
AUTOMATION_SERVICE_NAME=n8n
REQUIRE_AUTOMATION_SERVICE=true
N8N_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_LONG_RANDOM_ENCRYPTION_KEY
N8N_IMAGE=n8nio/n8n:2.36.2
N8N_EXECUTIONS_DATA_MAX_AGE=336

# --- Required off-site S3 backup ---
# Use a dedicated bucket/prefix and credentials with only the required object scope.
OFFSITE_BACKUP_REQUIRED=true
BACKUP_DIR=/srv/three-crowns/backups
RETENTION_DAYS=14
S3_ENDPOINT_URL=CHANGE_ME_BEGET_S3_HTTPS_ENDPOINT
S3_REGION=CHANGE_ME_S3_REGION
S3_BACKUP_BUCKET=CHANGE_ME_BACKUP_BUCKET
S3_BACKUP_PREFIX=production
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY

# Public website AI administrator + sales/voice models. Leave blank until provider is launch-enabled.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_PUBLIC_ASSISTANT_MODEL=
OPENAI_WHATSAPP_MODEL=
OPENAI_SALES_MODEL=
OPENAI_TIMEOUT_SECONDS=30
AI_ADMIN_MAX_MESSAGES=12
AI_ADMIN_RATE_LIMIT_PER_MINUTE=20
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=60

# GREEN API WhatsApp. Leave blank until real provider E2E is approved.
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
TELEGRAM_STAFF_WEBHOOK_SECRET=
STAFF_VOICE_MAX_BYTES=20000000

TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_WEBHOOK_SECRET=
TELEGRAM_SALES_CHANNEL_CODE=TELEGRAM_SALES
TELEGRAM_SALES_DISPLAY_NAME=Telegram Sales
TELEGRAM_SALES_ACCOUNT_ID=
TELEGRAM_PROVIDER_TIMEOUT_SECONDS=10
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Bootstrap credentials must never remain populated after the authorized owner account is created.
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_DISPLAY_NAME=Owner

# V1 payment amount/terms remain manager-controlled.
# Growth has no automatic outbound authority.
# NFC remains deferred and absent from active runtime.
