# Three Crowns staging only. Copy to .env.staging on the staging host.
# Never commit real secrets or reuse production database/password/session credentials.

POSTGRES_DB=resort_os_staging
POSTGRES_USER=resort_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DATABASE_PASSWORD

PROPERTY_CODE=THREE_CROWNS
RATE_PLAN_CODE=DIRECT_2026_27
APP_ENV=staging

# Exact staging HTTPS origins only.
# During localhost-only acceptance this may be empty.
# Example after TLS: https://staging.3korony.com,https://pms-staging.3korony.com,https://staff-staging.3korony.com,https://guest-staging.3korony.com
CORS_ORIGINS=

# Browser-visible websocket origin for localhost compose testing.
# Before an HTTPS same-origin build, set this blank so PMS uses wss://<pms-host>/ws/...
NEXT_PUBLIC_CORE_WS_URL=ws://127.0.0.1:18000

SESSION_TTL_HOURS=8
# localhost-only first acceptance is plain HTTP and bound to 127.0.0.1, so Secure cookies cannot be used yet.
# Set COOKIE_SECURE=true before exposing any HTTPS staging hostname, restart Core, and rerun acceptance over HTTPS.
COOKIE_SECURE=false
REQUIRE_COOKIE_DOMAIN=false
COOKIE_DOMAIN=

# MY STAY guest sessions. Generate a dedicated random value; never reuse staff/n8n secrets.
GUEST_SESSION_SECRET=CHANGE_ME_STAGING_GUEST_SESSION_SECRET_AT_LEAST_32_CHARS
GUEST_SESSION_HOURS=24
GUEST_HOST=guest-staging.3korony.com

# Smart access remains fail-closed until a dedicated staging controller is connected.
SMART_ACCESS_CONTROLLER_URL=
SMART_ACCESS_HMAC_SECRET=CHANGE_ME_STAGING_ACCESS_HMAC_SECRET_AT_LEAST_32_CHARS

# Public paid-access testing uses a staging-only payment bridge. Leave checkout URL blank
# until a sandbox acquiring/provider flow is intentionally enabled.
PUBLIC_ACCESS_TOKEN_SECRET=CHANGE_ME_STAGING_PUBLIC_ACCESS_TOKEN_SECRET_AT_LEAST_32_CHARS
PUBLIC_ACCESS_CHECKOUT_URL=
PUBLIC_ACCESS_INTENT_MINUTES=10

# n8n/service calls use a staging-only key. Never reuse production.
AUTOMATION_SERVICE_KEY=CHANGE_ME_STAGING_SERVICE_KEY_AT_LEAST_32_CHARS
AUTOMATION_SERVICE_NAME=n8n-staging
REQUIRE_AUTOMATION_SERVICE=true

EXPECTED_ROOM_COUNT=84
EXPECTED_ROOM_TYPE_COUNT=12
REQUIRE_MIGRATION_HISTORY=true
# Staging gate does not require a production backup freshness claim.
REQUIRE_RECENT_BACKUP=false
LAST_VERIFIED_BACKUP_AT=
MAX_BACKUP_AGE_HOURS=

# Provider safety: leave all real provider credentials empty in staging by default.
# Telegram Mini App login can be enabled later with a dedicated staging bot only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
TELEGRAM_STAFF_WEBHOOK_SECRET=
STAFF_VOICE_MAX_BYTES=20000000
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=60
TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_WEBHOOK_SECRET=
TELEGRAM_SALES_CHANNEL_CODE=TELEGRAM_SALES_STAGING
TELEGRAM_SALES_DISPLAY_NAME=Telegram Sales Staging
TELEGRAM_SALES_ACCOUNT_ID=
TELEGRAM_PROVIDER_TIMEOUT_SECONDS=10
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Temporary staging owner. Rotate/remove after smoke.
BOOTSTRAP_OWNER_USERNAME=staging_owner
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_STAGING_OWNER_PASSWORD
BOOTSTRAP_OWNER_DISPLAY_NAME=Staging Owner

# Synthetic role accounts used only for staging acceptance.
STAGING_MAID_USERNAME=staging_maid
STAGING_MAID_PASSWORD=CHANGE_ME_STAGING_MAID_PASSWORD
STAGING_MAID_DISPLAY_NAME=Staging Maid
STAGING_TECHNICIAN_USERNAME=staging_tech
STAGING_TECHNICIAN_PASSWORD=CHANGE_ME_STAGING_TECH_PASSWORD
STAGING_TECHNICIAN_DISPLAY_NAME=Staging Technician
STAGING_DINING_USERNAME=staging_dining
STAGING_DINING_PASSWORD=CHANGE_ME_STAGING_DINING_PASSWORD
STAGING_DINING_DISPLAY_NAME=Staging Dining
STAGING_RECEPTION_USERNAME=staging_reception
STAGING_RECEPTION_PASSWORD=CHANGE_ME_STAGING_RECEPTION_PASSWORD
STAGING_RECEPTION_DISPLAY_NAME=Staging Reception

# Smoke uses only synthetic guest/payment/task data.
SMOKE_OWNER_USERNAME=staging_owner
SMOKE_OWNER_PASSWORD=CHANGE_ME_STAGING_OWNER_PASSWORD
SMOKE_MAID_USERNAME=staging_maid
SMOKE_MAID_PASSWORD=CHANGE_ME_STAGING_MAID_PASSWORD
SMOKE_TECHNICIAN_USERNAME=staging_tech
SMOKE_TECHNICIAN_PASSWORD=CHANGE_ME_STAGING_TECH_PASSWORD
SMOKE_DINING_USERNAME=staging_dining
SMOKE_DINING_PASSWORD=CHANGE_ME_STAGING_DINING_PASSWORD
SMOKE_RECEPTION_USERNAME=staging_reception
SMOKE_RECEPTION_PASSWORD=CHANGE_ME_STAGING_RECEPTION_PASSWORD
