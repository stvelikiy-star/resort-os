# Three Crowns Resort OS production environment template.
# Copy to a secret store or host-local .env; never commit real credentials.
# Source CI validates this contract only; it does not authorize a live deployment.

# Explicit owner / DNS cutover gates.
# Keep both false until the production cutover has been separately approved and public DNS is ready.
PRODUCTION_CUTOVER_APPROVED=false
PUBLIC_DNS_READY=false

# PostgreSQL
POSTGRES_DB=resort_os
POSTGRES_USER=resort
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
BACKUP_RETENTION_DAYS=14

# Production preflight / recovery evidence.
# LAST_VERIFIED_BACKUP_AT must come from a successful backup + isolated restore verification.
REQUIRE_RECENT_BACKUP=true
LAST_VERIFIED_BACKUP_AT=CHANGE_ME_VERIFIED_BACKUP_ISO8601
MAX_BACKUP_AGE_HOURS=24
REQUIRE_MIGRATION_HISTORY=true
EXPECTED_ROOM_COUNT=84
EXPECTED_ROOM_TYPE_COUNT=12

# Property / pricing
PROPERTY_CODE=THREE_CROWNS
RATE_PLAN_CODE=DIRECT_2026_27

# Public origins / host-isolated secure session cookies.
# Leave COOKIE_DOMAIN empty so HttpOnly sessions are bound to the hostname that performed login.
CORS_ORIGINS=https://3korony.com,https://www.3korony.com,https://pms.3korony.com,https://staff.3korony.com
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
COOKIE_DOMAIN=
REQUIRE_COOKIE_DOMAIN=false

# Hostnames / automatic TLS
ACME_EMAIL=CHANGE_ME_OWNER_EMAIL
PUBLIC_HOST=3korony.com
WWW_HOST=www.3korony.com
PMS_HOST=pms.3korony.com
STAFF_HOST=staff.3korony.com
CORE_HOST=core.3korony.com

# Automation boundary
AUTOMATION_SERVICE_KEY=CHANGE_ME_64_PLUS_RANDOM_CHARS
AUTOMATION_SERVICE_NAME=n8n
REQUIRE_AUTOMATION_SERVICE=true

# Telegram / staff integration (leave empty until configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
TELEGRAM_STAFF_WEBHOOK_SECRET=

# AI transcription (leave empty until configured)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Bootstrap is ONLY for a database that has no active OWNER yet.
# After first successful bootstrap, clear BOOTSTRAP_OWNER_PASSWORD from the host/secret store.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_MIN_12_CHARS
BOOTSTRAP_OWNER_DISPLAY_NAME="Three Crowns Owner"
