# Copy to .env.production only on the deployment host.
# Never commit real secrets.

# --- Single-server domain / TLS ---
PUBLIC_HOST=3korony.com
ADMIN_HOST=admin.3korony.com
STAFF_HOST=staff.3korony.com
API_HOST=api.3korony.com
AUTOMATION_HOST=automation.3korony.com
TLS_EMAIL=CHANGE_ME_OWNER_EMAIL

HOST_DATA_DIR=/srv/three-crowns/data

POSTGRES_DB=resort_os
POSTGRES_USER=resort
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

PROPERTY_CODE=THREE_CROWNS
RATE_PLAN_CODE=DIRECT_2026_27

CORS_ORIGINS=https://3korony.com,https://admin.3korony.com,https://staff.3korony.com
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
REQUIRE_COOKIE_DOMAIN=false
COOKIE_DOMAIN=

# Staff login brute-force protection. The production compose topology exposes Resort
# Core only through controlled Caddy, so X-Forwarded-For may be trusted here. Do not
# enable AUTH_TRUST_PROXY_HEADERS if the API can be reached directly from untrusted clients.
AUTH_TRUST_PROXY_HEADERS=true
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_PAIR_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=30

AUTOMATION_SERVICE_KEY=CHANGE_ME_LONG_RANDOM_SERVICE_KEY_AT_LEAST_32_CHARS
AUTOMATION_SERVICE_NAME=n8n
REQUIRE_AUTOMATION_SERVICE=true
N8N_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_LONG_RANDOM_ENCRYPTION_KEY
N8N_IMAGE=n8nio/n8n:2.36.2

# Public website AI administrator + WhatsApp AI reply models.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_PUBLIC_ASSISTANT_MODEL=
OPENAI_WHATSAPP_MODEL=
OPENAI_SALES_MODEL=
OPENAI_TIMEOUT_SECONDS=30
AI_ADMIN_MAX_MESSAGES=12
AI_ADMIN_RATE_LIMIT_PER_MINUTE=20

# GREEN API WhatsApp transport for n8n.
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_WEBHOOK_SECRET

EXPECTED_ROOM_COUNT=84
EXPECTED_ROOM_TYPE_COUNT=12
REQUIRE_MIGRATION_HISTORY=true
REQUIRE_RECENT_BACKUP=true
LAST_VERIFIED_BACKUP_AT=
MAX_BACKUP_AGE_HOURS=24
BACKUP_DIR=/srv/three-crowns/backups
RETENTION_DAYS=14

TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
TELEGRAM_STAFF_WEBHOOK_SECRET=
STAFF_VOICE_MAX_BYTES=20000000
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=60

TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_WEBHOOK_SECRET=
TELEGRAM_SALES_CHANNEL_CODE=TELEGRAM_SALES
TELEGRAM_SALES_DISPLAY_NAME=Telegram Sales
TELEGRAM_SALES_ACCOUNT_ID=
TELEGRAM_PROVIDER_TIMEOUT_SECONDS=10
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_DISPLAY_NAME=Owner

# V1 payment rule remains manager-owned; no automatic global prepayment percentage.
# NFC is deferred and intentionally not part of the active production contract.
