# Copy to .env.production only on the deployment host.
# Never commit real secrets.

POSTGRES_DB=resort_os
POSTGRES_USER=resort
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

PROPERTY_CODE=THREE_CROWNS
RATE_PLAN_CODE=DIRECT_2026_27
PREPAYMENT_PERCENT=30

# Exact deployed HTTPS origins, comma-separated. Example shape only:
# https://3korony.com,https://<admin-host>,https://<staff-host>
CORS_ORIGINS=

SESSION_TTL_HOURS=12
COOKIE_SECURE=true
# Set only when admin/staff/API intentionally share authentication across subdomains.
COOKIE_DOMAIN=

# Generate a long random value on the deployment host.
AUTOMATION_SERVICE_KEY=CHANGE_ME_LONG_RANDOM_SERVICE_KEY
AUTOMATION_SERVICE_NAME=n8n

# Optional until Telegram Mini App is connected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600

# NFC is intentionally omitted from the active deployment contract.
