DATABASE_URL=postgresql://resort:resort@localhost:5432/resort_os?schema=public
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
PROPERTY_CODE=THREE_CROWNS
RATE_PLAN_CODE=DIRECT_2026_27
PREPAYMENT_PERCENT=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Staff/admin session cookies.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# Production example when PMS/staff/API use sibling subdomains: .3korony.com
COOKIE_DOMAIN=

# n8n is the active V1 client-automation boundary.
# Instagram -> ManyChat -> n8n; WhatsApp -> API Green -> n8n.
# n8n must call Resort Core and must never write PostgreSQL directly.
AUTOMATION_SERVICE_NAME=n8n
AUTOMATION_SERVICE_KEY=
RESORT_CORE_URL=http://localhost:8000
REQUIRE_AUTOMATION_SERVICE=true

# Production data/preflight expectations.
EXPECTED_ROOM_COUNT=84
EXPECTED_ROOM_TYPE_COUNT=12
REQUIRE_MIGRATION_HISTORY=true
REQUIRE_RECENT_BACKUP=true
# Fill only after a successful backup -> restore verification.
LAST_VERIFIED_BACKUP_AT=
# Optional freshness gate. Leave empty until an operating backup cadence is approved.
MAX_BACKUP_AGE_HOURS=

# Staff Telegram Mini App authentication and technician voice webhook.
# This is hotel staff automation, not the main client-channel architecture.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
TELEGRAM_STAFF_WEBHOOK_SECRET=
STAFF_VOICE_MAX_BYTES=20000000

# Optional/reference direct Telegram Sales adapter retained in Core.
# Main client communication should normally be orchestrated by n8n.
TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_WEBHOOK_SECRET=
TELEGRAM_SALES_CHANNEL_CODE=TELEGRAM_SALES
TELEGRAM_SALES_DISPLAY_NAME=Telegram Sales
TELEGRAM_SALES_ACCOUNT_ID=
TELEGRAM_PROVIDER_TIMEOUT_SECONDS=10
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Optional Resort Core OpenAI adapters. Production client AI is expected to be
# orchestrated mainly in n8n; Core never silently selects a model.
OPENAI_API_KEY=
OPENAI_SALES_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=60

# Deferred NFC implementation secret. NFC is NOT part of the active Three Crowns
# engineering queue; keep empty unless the owner explicitly reactivates the module.
NFC_UID_PEPPER=

# Set locally only when bootstrapping/resetting the first owner account.
# Never commit real credentials and clear BOOTSTRAP_OWNER_PASSWORD before production.
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_DISPLAY_NAME=Owner
