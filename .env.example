DATABASE_URL=postgresql://resort:resort@localhost:5432/resort_os?schema=public
API_HOST=0.0.0.0
API_PORT=8000
PROPERTY_CODE=THREE_CROWNS
RATE_PLAN_CODE=DIRECT_2026_27
PREPAYMENT_PERCENT=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Staff/admin session cookies.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# Production example when PMS/staff/API use sibling subdomains: .3korony.com
COOKIE_DOMAIN=

# Telegram Mini App authentication. Never commit the real bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600

# n8n / AI service boundary. Generate a long random secret for production.
AUTOMATION_SERVICE_NAME=n8n
AUTOMATION_SERVICE_KEY=
# Used by the n8n templates, not read by Resort Core itself.
RESORT_CORE_URL=http://localhost:8000

# NFC UID hashing pepper. Must be a high-entropy production secret and must stay stable
# while issued bracelets exist. Raw bracelet UIDs are not stored in PostgreSQL.
NFC_UID_PEPPER=

# Set locally only when bootstrapping/resetting the first owner account.
# Never commit real credentials.
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_DISPLAY_NAME=Owner
