generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomOperationalState {
  UNKNOWN
  CLEAN
  DIRTY
  IN_INSPECTION
  TECH_BLOCK
}

enum RateSaleStatus {
  OPEN
  CLOSED
  CONFIRM_REQUIRED
}

enum ReservationRequestStatus {
  NEW
  QUOTED
  AWAITING_PREPAYMENT
  CONVERTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ReservationStatus {
  GUARANTEED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  RECEIVED
  FAILED
  REFUNDED
  CANCELLED
}

enum InventoryBlockType {
  RESERVATION
  MAINTENANCE
  MANUAL
}

enum StaffRole {
  OWNER
  MANAGER
  RECEPTION
  MAID
  TECHNICIAN
  STORE_STAFF
  DINING_STAFF
  CONTENT_MANAGER
  BEACH_PARTNER
}

enum OperationalTaskType {
  HOUSEKEEPING
  MAINTENANCE
  GUEST_REQUEST
}

enum OperationalTaskStatus {
  OPEN
  IN_PROGRESS
  IN_INSPECTION
  DONE
  CANCELLED
}

enum OperationalTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StayStatus {
  PENDING
  ACTIVE
  CHECKED_OUT
  CANCELLED
}

enum RoomQrStatus {
  ACTIVE
  REVOKED
}

enum GuestSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum NfcWalletStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum NfcBraceletStatus {
  ACTIVE
  BLOCKED
  LOST
  RETURNED
}

enum NfcTransactionStatus {
  COMPLETED
  REVERSED
}

enum CommunicationChannelKind {
  WEBSITE
  TELEGRAM
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum ConversationStatus {
  OPEN
  WAITING_GUEST
  WAITING_STAFF
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageDeliveryStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNKNOWN
}

model Property {
  id                    String                   @id @default(uuid()) @db.Uuid
  code                  String                   @unique
  name                  String
  timezone              String                   @default("Asia/Bishkek")
  currency              String                   @default("KGS")
  beachCommissionBps    Int                      @default(500)
  roomTypes             RoomType[]
  rooms                 Room[]
  ratePlans             RatePlan[]
  guests                Guest[]
  requests              ReservationRequest[]
  reservations          Reservation[]
  stays                 Stay[]
  roomAssignments       RoomAssignment[]
  roomQrs               RoomQr[]
  guestSessions         GuestSession[]
  guestHistoryEvents    GuestHistoryEvent[]
  guestPreferences      GuestPreference[]
  auditLogs             AuditLog[]
  staffUsers            StaffUser[]
  tasks                 OperationalTask[]
  automationEvents      AutomationInboundEvent[]
  communicationChannels CommunicationChannel[]
  conversations         Conversation[]
  nfcWallets            NfcWallet[]
  nfcBracelets          NfcBracelet[]
  nfcTransactions       NfcTransaction[]
  analyticsSnapshots    OwnerAnalyticsSnapshot[]
  guestEngagements      GuestEngagement[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@map("properties")
}

model RoomType {
  id                String               @id @default(uuid()) @db.Uuid
  propertyId        String               @db.Uuid
  property          Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code              String
  name              String
  capacityAdults    Int
  capacityChildren  Int?
  areaLabel         String?
  rooms             Room[]
  ratePeriods       RatePeriod[]
  desiredByRequests ReservationRequest[] @relation("RequestedRoomType")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([propertyId, code])
  @@unique([propertyId, name])
  @@map("room_types")
}

model Room {
  id               String               @id @default(uuid()) @db.Uuid
  propertyId       String               @db.Uuid
  property         Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId       String               @db.Uuid
  roomType         RoomType             @relation(fields: [roomTypeId], references: [id])
  code             String
  name             String
  buildingOrZone   String?
  floorLabel       String?
  bedConfiguration String?
  areaLabel        String?
  operationalState RoomOperationalState @default(UNKNOWN)
  notes            String?
  inventoryBlocks  InventoryBlock[]
  roomAssignments  RoomAssignment[]
  roomQrs          RoomQr[]
  tasks            OperationalTask[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([propertyId, code])
  @@index([propertyId, roomTypeId])
  @@map("rooms")
}

model RatePlan {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code       String
  name       String
  currency   String       @default("KGS")
  periods    RatePeriod[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([propertyId, code])
  @@map("rate_plans")
}

model RatePeriod {
  id           String         @id @default(uuid()) @db.Uuid
  ratePlanId   String         @db.Uuid
  ratePlan     RatePlan       @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomTypeId   String         @db.Uuid
  roomType     RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  label        String
  validFrom    DateTime       @db.Date
  validTo      DateTime       @db.Date
  priceKgs     Int
  mealIncluded String
  saleStatus   RateSaleStatus @default(OPEN)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([ratePlanId, roomTypeId, validFrom, validTo])
  @@index([roomTypeId, validFrom, validTo])
  @@map("rate_periods")
}

model Guest {
  id            String              @id @default(uuid()) @db.Uuid
  propertyId    String              @db.Uuid
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  firstName     String?
  lastName      String?
  phone         String?
  email         String?
  reservations  Reservation[]
  stays         Stay[]
  guestSessions GuestSession[]
  historyEvents GuestHistoryEvent[]
  preferences   GuestPreference[]
  nfcWallets    NfcWallet[]
  engagements   GuestEngagement[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([propertyId, phone])
  @@map("guests")
}

model ReservationRequest {
  id                    String                   @id @default(uuid()) @db.Uuid
  propertyId            String                   @db.Uuid
  property              Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status                ReservationRequestStatus @default(NEW)
  source                String?
  guestName             String
  phone                 String
  email                 String?
  checkIn               DateTime                 @db.Date
  checkOut              DateTime                 @db.Date
  adults                Int
  children              Int                      @default(0)
  desiredRoomTypeId     String?                  @db.Uuid
  desiredRoomType       RoomType?                @relation("RequestedRoomType", fields: [desiredRoomTypeId], references: [id])
  quotedTotalKgs        Int?
  requiredPrepaymentKgs Int?
  notes                 String?
  reservation           Reservation?
  payments              Payment[]
  conversations         Conversation[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([propertyId, createdAt])
  @@index([status])
  @@map("reservation_requests")
}

model Reservation {
  id             String              @id @default(uuid()) @db.Uuid
  propertyId     String              @db.Uuid
  property       Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestId      String?             @unique @db.Uuid
  request        ReservationRequest? @relation(fields: [requestId], references: [id])
  bookingNumber  String              @unique
  primaryGuestId String?             @db.Uuid
  primaryGuest   Guest?              @relation(fields: [primaryGuestId], references: [id])
  status         ReservationStatus   @default(GUARANTEED)
  checkIn        DateTime            @db.Date
  checkOut       DateTime            @db.Date
  adults         Int
  children       Int                 @default(0)
  totalKgs       Int
  notes          String?
  blocks         InventoryBlock[]
  payments       Payment[]
  serviceTasks   OperationalTask[]   @relation("ReservationGuestServices")
  engagements    GuestEngagement[]
  stay           Stay?
  nfcWallet      NfcWallet?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([propertyId, checkIn, checkOut])
  @@map("reservations")
}

model Stay {
  id                      String             @id @default(uuid()) @db.Uuid
  propertyId              String             @db.Uuid
  property                Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId           String             @unique @db.Uuid
  reservation             Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestId                 String             @db.Uuid
  guest                   Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  status                  StayStatus         @default(PENDING)
  actualCheckInAt         DateTime?
  actualCheckOutAt        DateTime?
  guestAccessPinHash      String?
  guestAccessPinIssuedAt  DateTime?
  guestAccessPinExpiresAt DateTime?
  roomAssignments         RoomAssignment[]
  guestSessions           GuestSession[]
  tasks                   OperationalTask[]
  historyEvents           GuestHistoryEvent[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([propertyId, status])
  @@index([guestId, createdAt])
  @@map("stays")
}

model RoomAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @db.Uuid
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stayId     String    @db.Uuid
  stay       Stay      @relation(fields: [stayId], references: [id], onDelete: Cascade)
  roomId     String    @db.Uuid
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startedAt  DateTime
  endedAt    DateTime?
  source     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([propertyId, roomId, startedAt, endedAt])
  @@index([stayId, startedAt])
  @@map("room_assignments")
}

model RoomQr {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId     String       @db.Uuid
  room       Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique
  status     RoomQrStatus @default(ACTIVE)
  label      String?
  issuedAt   DateTime     @default(now())
  revokedAt  DateTime?
  sessions   GuestSession[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([propertyId, roomId, status])
  @@map("room_qrs")
}

model GuestSession {
  id                 String             @id @default(uuid()) @db.Uuid
  propertyId         String             @db.Uuid
  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stayId             String             @db.Uuid
  stay               Stay               @relation(fields: [stayId], references: [id], onDelete: Cascade)
  guestId            String             @db.Uuid
  guest              Guest              @relation(fields: [guestId], references: [id], onDelete: Cascade)
  roomQrId           String?            @db.Uuid
  roomQr             RoomQr?            @relation(fields: [roomQrId], references: [id], onDelete: SetNull)
  tokenHash          String             @unique
  status             GuestSessionStatus @default(ACTIVE)
  verificationMethod String             @default("PIN")
  verifiedAt         DateTime            @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  lastSeenAt         DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([propertyId, stayId, status])
  @@index([guestId, createdAt])
  @@index([expiresAt, status])
  @@map("guest_sessions")
}

model GuestHistoryEvent {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId     String    @db.Uuid
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  stayId      String?   @db.Uuid
  stay        Stay?     @relation(fields: [stayId], references: [id], onDelete: SetNull)
  eventType   String
  source      String?
  payloadJson Json?
  occurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([propertyId, guestId, occurredAt])
  @@index([stayId, occurredAt])
  @@map("guest_history_events")
}

model GuestPreference {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId    String   @db.Uuid
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  key        String
  valueText  String?
  metadata   Json?
  source     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([guestId, key])
  @@index([propertyId, guestId, isActive])
  @@map("guest_preferences")
}

model InventoryBlock {
  id            String             @id @default(uuid()) @db.Uuid
  roomId        String             @db.Uuid
  room          Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservationId String?            @db.Uuid
  reservation   Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  blockType     InventoryBlockType
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  active        Boolean            @default(true)
  reason        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([roomId, startDate, endDate])
  @@map("inventory_blocks")
}

model Payment {
  id             String              @id @default(uuid()) @db.Uuid
  requestId      String?             @db.Uuid
  request        ReservationRequest? @relation(fields: [requestId], references: [id])
  reservationId  String?             @db.Uuid
  reservation    Reservation?        @relation(fields: [reservationId], references: [id])
  amountKgs      Int
  method         String
  status         PaymentStatus       @default(PENDING)
  provider       String?
  externalRef    String?
  idempotencyKey String?             @unique
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([requestId])
  @@index([reservationId])
  @@unique([provider, externalRef])
  @@map("payments")
}

model StaffUser {
  id                    String            @id @default(uuid()) @db.Uuid
  propertyId            String            @db.Uuid
  property              Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  username              String
  displayName           String
  passwordHash          String
  role                   StaffRole
  isActive              Boolean           @default(true)
  telegramUserId        String?
  telegramUsername      String?
  telegramLinkedAt      DateTime?
  sessions              AuthSession[]
  assignedTasks         OperationalTask[] @relation("TaskAssignee")
  assignedConversations Conversation[]    @relation("ConversationAssignee")
  beachTransactions     NfcTransaction[]  @relation("BeachPartnerTransactions")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([propertyId, username])
  @@unique([propertyId, telegramUserId])
  @@index([propertyId, role])
  @@map("staff_users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt DateTime   @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OperationalTask {
  id            String                  @id @default(uuid()) @db.Uuid
  propertyId    String                  @db.Uuid
  property      Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String?                 @db.Uuid
  room          Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reservationId String?                 @db.Uuid
  reservation   Reservation?            @relation("ReservationGuestServices", fields: [reservationId], references: [id], onDelete: SetNull)
  stayId        String?                 @db.Uuid
  stay          Stay?                   @relation(fields: [stayId], references: [id], onDelete: SetNull)
  serviceCode   String?
  serviceDate   DateTime?               @db.Date
  serviceTime   String?
  type          OperationalTaskType
  status        OperationalTaskStatus   @default(OPEN)
  priority      OperationalTaskPriority @default(NORMAL)
  title         String
  description   String?
  assignedToId  String?                 @db.Uuid
  assignedTo    StaffUser?              @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByType String
  createdById   String?
  source        String?
  completedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([propertyId, status, type])
  @@index([roomId, status])
  @@index([reservationId, status])
  @@index([stayId, status])
  @@index([propertyId, serviceCode, status, serviceDate])
  @@index([assignedToId, status])
  @@map("operational_tasks")
}

model AutomationInboundEvent {
  id               String    @id @default(uuid()) @db.Uuid
  propertyId       String    @db.Uuid
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source           String
  idempotencyKey   String
  eventType        String
  payloadJson      Json
  resultResource   String?
  resultResourceId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([propertyId, source, idempotencyKey])
  @@index([propertyId, eventType, createdAt])
  @@map("automation_inbound_events")
}

model CommunicationChannel {
  id                String                   @id @default(uuid()) @db.Uuid
  propertyId        String                   @db.Uuid
  property          Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code              String
  kind              CommunicationChannelKind
  displayName       String
  externalAccountId String?
  isActive          Boolean                  @default(true)
  metadata          Json?
  conversations     Conversation[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([propertyId, code])
  @@index([propertyId, kind, isActive])
  @@map("communication_channels")
}

model Conversation {
  id                     String               @id @default(uuid()) @db.Uuid
  propertyId             String               @db.Uuid
  property               Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channelId              String               @db.Uuid
  channel                CommunicationChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  externalConversationId String?
  externalContactId      String?
  contactName            String?
  contactPhone           String?
  contactUsername        String?
  status                 ConversationStatus   @default(OPEN)
  assignedToId           String?              @db.Uuid
  assignedTo             StaffUser?           @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reservationRequestId   String?              @db.Uuid
  reservationRequest     ReservationRequest?  @relation(fields: [reservationRequestId], references: [id], onDelete: SetNull)
  lastInboundAt          DateTime?
  lastOutboundAt         DateTime?
  firstResponseAt        DateTime?
  resolvedAt             DateTime?
  messages               ConversationMessage[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([channelId, externalConversationId])
  @@index([propertyId, status, updatedAt])
  @@index([assignedToId, status])
  @@index([reservationRequestId])
  @@map("conversations")
}

model ConversationMessage {
  id                String                @id @default(uuid()) @db.Uuid
  conversationId    String                @db.Uuid
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  externalMessageId String?
  senderType        String
  senderExternalId  String?
  text              String?
  contentType       String                @default("TEXT")
  deliveryStatus    MessageDeliveryStatus @default(UNKNOWN)
  rawPayload        Json?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model NfcWallet {
  id            String          @id @default(uuid()) @db.Uuid
  propertyId    String          @db.Uuid
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String          @unique @db.Uuid
  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestId       String          @db.Uuid
  guest         Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  balanceKgs    Int             @default(0)
  status        NfcWalletStatus @default(ACTIVE)
  bracelets     NfcBracelet[]
  transactions  NfcTransaction[]
  ledgerEntries NfcLedgerEntry[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([propertyId, status])
  @@index([guestId])
  @@map("nfc_wallets")
}

model NfcBracelet {
  id           String            @id @default(uuid()) @db.Uuid
  propertyId   String            @db.Uuid
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  walletId     String            @db.Uuid
  wallet       NfcWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  uidHash      String
  status       NfcBraceletStatus @default(ACTIVE)
  label        String?
  issuedAt     DateTime          @default(now())
  returnedAt   DateTime?
  transactions NfcTransaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([propertyId, uidHash])
  @@index([walletId, status])
  @@map("nfc_bracelets")
}

model NfcTransaction {
  id                 String               @id @default(uuid()) @db.Uuid
  propertyId         String               @db.Uuid
  property           Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  walletId           String               @db.Uuid
  wallet             NfcWallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  braceletId         String               @db.Uuid
  bracelet           NfcBracelet          @relation(fields: [braceletId], references: [id], onDelete: Restrict)
  partnerStaffUserId String               @db.Uuid
  partnerStaffUser   StaffUser            @relation("BeachPartnerTransactions", fields: [partnerStaffUserId], references: [id], onDelete: Restrict)
  amountKgs          Int
  hotelCommissionKgs Int
  partnerNetKgs      Int
  commissionBps      Int
  status             NfcTransactionStatus @default(COMPLETED)
  idempotencyKey     String
  description        String?
  externalRef        String?
  ledgerEntry        NfcLedgerEntry?
  createdAt          DateTime             @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([partnerStaffUserId, createdAt])
  @@map("nfc_transactions")
}

model NfcLedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  walletId         String          @db.Uuid
  wallet           NfcWallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transactionId    String?         @unique @db.Uuid
  transaction      NfcTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  entryType        String
  deltaKgs         Int
  balanceBeforeKgs Int
  balanceAfterKgs  Int
  note             String?
  createdAt        DateTime        @default(now())

  @@index([walletId, createdAt])
  @@map("nfc_ledger_entries")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id])
  actorType  String
  actorId    String?
  action     String
  resource   String
  resourceId String?
  source     String?
  result     String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime  @default(now())

  @@index([propertyId, createdAt])
  @@map("audit_logs")
}

model OwnerAnalyticsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  snapshotDate DateTime @db.Date
  horizonDays  Int
  payloadJson  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([propertyId, snapshotDate])
  @@index([propertyId, snapshotDate])
  @@map("owner_analytics_snapshots")
}

model GuestEngagement {
  id            String       @id @default(uuid()) @db.Uuid
  propertyId    String       @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId       String       @db.Uuid
  guest         Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?      @db.Uuid
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  kind          String
  status        String       @default("OPEN")
  dueDate       DateTime?    @db.Date
  channelHint   String?
  title         String
  notes         String?
  score         Int?
  feedbackText  String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId, status, dueDate])
  @@index([guestId, createdAt])
  @@index([reservationId])
  @@map("guest_engagements")
}