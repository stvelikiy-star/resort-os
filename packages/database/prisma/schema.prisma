generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomOperationalState {
  UNKNOWN
  CLEAN
  DIRTY
  IN_INSPECTION
  TECH_BLOCK
}

enum RateSaleStatus {
  OPEN
  CLOSED
  CONFIRM_REQUIRED
}

enum ReservationRequestStatus {
  NEW
  QUOTED
  AWAITING_PREPAYMENT
  CONVERTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ReservationStatus {
  GUARANTEED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  RECEIVED
  FAILED
  REFUNDED
  CANCELLED
}

enum InventoryBlockType {
  RESERVATION
  MAINTENANCE
  MANUAL
}

enum StaffRole {
  OWNER
  MANAGER
  MAID
  TECHNICIAN
  BEACH_PARTNER
  ADMIN
  RECEPTION
  DINING
}

enum OperationalTaskType {
  HOUSEKEEPING
  MAINTENANCE
  GUEST_REQUEST
}

enum OperationalTaskStatus {
  OPEN
  IN_PROGRESS
  IN_INSPECTION
  DONE
  CANCELLED
}

enum OperationalTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NfcWalletStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum NfcBraceletStatus {
  ACTIVE
  BLOCKED
  LOST
  RETURNED
}

enum NfcTransactionStatus {
  COMPLETED
  REVERSED
}

enum CommunicationChannelKind {
  WEBSITE
  TELEGRAM
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum ConversationStatus {
  OPEN
  WAITING_GUEST
  WAITING_STAFF
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageDeliveryStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNKNOWN
}

model Property {
  id                         String                      @id @default(uuid()) @db.Uuid
  code                       String                      @unique
  name                       String
  timezone                   String                      @default("Asia/Bishkek")
  currency                   String                      @default("KGS")
  beachCommissionBps         Int                         @default(500)
  roomTypes                  RoomType[]
  rooms                      Room[]
  ratePlans                  RatePlan[]
  guests                     Guest[]
  requests                   ReservationRequest[]
  reservations               Reservation[]
  auditLogs                  AuditLog[]
  staffUsers                 StaffUser[]
  tasks                      OperationalTask[]
  automationEvents           AutomationInboundEvent[]
  communicationChannels      CommunicationChannel[]
  conversations              Conversation[]
  nfcWallets                 NfcWallet[]
  nfcBracelets               NfcBracelet[]
  nfcTransactions            NfcTransaction[]
  analyticsSnapshots         OwnerAnalyticsSnapshot[]
  guestEngagements           GuestEngagement[]
  guestAccessCredentials     GuestAccessCredential[]
  reservationMealPlans       ReservationMealPlan[]
  diningMenuItems            DiningMenuItem[]
  diningOrders               DiningOrder[]
  reservationCharges         ReservationCharge[]
  smartAccessPoints          SmartAccessPoint[]
  smartAccessGrants          SmartAccessGrant[]
  publicAccessPaymentIntents PublicAccessPaymentIntent[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@map("properties")
}

model RoomType {
  id                String               @id @default(uuid()) @db.Uuid
  propertyId        String               @db.Uuid
  property          Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code              String
  name              String
  capacityAdults    Int
  capacityChildren  Int?
  areaLabel         String?
  rooms             Room[]
  ratePeriods       RatePeriod[]
  desiredByRequests ReservationRequest[] @relation("RequestedRoomType")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([propertyId, code])
  @@unique([propertyId, name])
  @@map("room_types")
}

model Room {
  id                String               @id @default(uuid()) @db.Uuid
  propertyId        String               @db.Uuid
  property          Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId        String               @db.Uuid
  roomType          RoomType             @relation(fields: [roomTypeId], references: [id])
  code              String
  name              String
  buildingOrZone    String?
  floorLabel        String?
  bedConfiguration  String?
  areaLabel         String?
  operationalState  RoomOperationalState @default(UNKNOWN)
  notes             String?
  inventoryBlocks   InventoryBlock[]
  tasks             OperationalTask[]
  smartAccessPoints SmartAccessPoint[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([propertyId, code])
  @@index([propertyId, roomTypeId])
  @@map("rooms")
}

model RatePlan {
  id         String       @id @default(uuid()) @db.Uuid
  propertyId String       @db.Uuid
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code       String
  name       String
  currency   String       @default("KGS")
  periods    RatePeriod[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([propertyId, code])
  @@map("rate_plans")
}

model RatePeriod {
  id           String         @id @default(uuid()) @db.Uuid
  ratePlanId   String         @db.Uuid
  ratePlan     RatePlan       @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomTypeId   String         @db.Uuid
  roomType     RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  label        String
  validFrom    DateTime       @db.Date
  validTo      DateTime       @db.Date
  priceKgs     Int
  mealIncluded String
  saleStatus   RateSaleStatus @default(OPEN)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([ratePlanId, roomTypeId, validFrom, validTo])
  @@index([roomTypeId, validFrom, validTo])
  @@map("rate_periods")
}

model Guest {
  id           String            @id @default(uuid()) @db.Uuid
  propertyId   String            @db.Uuid
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  phone        String?
  email        String?
  reservations Reservation[]
  nfcWallets   NfcWallet[]
  engagements  GuestEngagement[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([propertyId, phone])
  @@map("guests")
}

model ReservationRequest {
  id                    String                   @id @default(uuid()) @db.Uuid
  propertyId            String                   @db.Uuid
  property              Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status                ReservationRequestStatus @default(NEW)
  source                String?
  guestName             String
  phone                 String
  email                 String?
  checkIn               DateTime                 @db.Date
  checkOut              DateTime                 @db.Date
  adults                Int
  children              Int                      @default(0)
  desiredRoomTypeId     String?                  @db.Uuid
  desiredRoomType       RoomType?                @relation("RequestedRoomType", fields: [desiredRoomTypeId], references: [id])
  quotedTotalKgs        Int?
  requiredPrepaymentKgs Int?
  notes                 String?
  reservation           Reservation?
  payments              Payment[]
  conversations         Conversation[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([propertyId, createdAt])
  @@index([status])
  @@map("reservation_requests")
}

model Reservation {
  id                    String                 @id @default(uuid()) @db.Uuid
  propertyId            String                 @db.Uuid
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestId             String?                @unique @db.Uuid
  request               ReservationRequest?    @relation(fields: [requestId], references: [id])
  bookingNumber         String                 @unique
  primaryGuestId        String?                @db.Uuid
  primaryGuest          Guest?                 @relation(fields: [primaryGuestId], references: [id])
  status                ReservationStatus      @default(GUARANTEED)
  checkIn               DateTime               @db.Date
  checkOut              DateTime               @db.Date
  adults                Int
  children              Int                    @default(0)
  totalKgs              Int
  notes                 String?
  blocks                InventoryBlock[]
  payments              Payment[]
  serviceTasks          OperationalTask[]      @relation("ReservationGuestServices")
  engagements           GuestEngagement[]
  nfcWallet             NfcWallet?
  guestAccessCredential GuestAccessCredential?
  mealPlans             ReservationMealPlan[]
  diningOrders          DiningOrder[]
  charges               ReservationCharge[]
  smartAccessGrants     SmartAccessGrant[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([propertyId, checkIn, checkOut])
  @@map("reservations")
}

model InventoryBlock {
  id            String             @id @default(uuid()) @db.Uuid
  roomId        String             @db.Uuid
  room          Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservationId String?            @db.Uuid
  reservation   Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  blockType     InventoryBlockType
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  active        Boolean            @default(true)
  reason        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([roomId, startDate, endDate])
  @@map("inventory_blocks")
}

model Payment {
  id                  String              @id @default(uuid()) @db.Uuid
  requestId           String?             @db.Uuid
  request             ReservationRequest? @relation(fields: [requestId], references: [id])
  reservationId       String?             @db.Uuid
  reservation         Reservation?        @relation(fields: [reservationId], references: [id])
  amountKgs           Int
  method              String
  status              PaymentStatus       @default(PENDING)
  provider            String?
  externalRef         String?
  idempotencyKey      String?             @unique
  metadata            Json?
  paidAt              DateTime?
  reservationCharges  ReservationCharge[]
  smartAccessGrants   SmartAccessGrant[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([requestId])
  @@index([reservationId])
  @@unique([provider, externalRef])
  @@map("payments")
}

model StaffUser {
  id                     String            @id @default(uuid()) @db.Uuid
  propertyId             String            @db.Uuid
  property               Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  username               String
  displayName            String
  passwordHash           String
  role                   StaffRole
  isActive               Boolean           @default(true)
  telegramUserId         String?
  telegramUsername       String?
  telegramLinkedAt       DateTime?
  sessions               AuthSession[]
  assignedTasks          OperationalTask[] @relation("TaskAssignee")
  assignedConversations  Conversation[]    @relation("ConversationAssignee")
  beachTransactions      NfcTransaction[]  @relation("BeachPartnerTransactions")
  createdDiningMenuItems DiningMenuItem[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([propertyId, username])
  @@unique([propertyId, telegramUserId])
  @@index([propertyId, role])
  @@map("staff_users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OperationalTask {
  id            String                  @id @default(uuid()) @db.Uuid
  propertyId    String                  @db.Uuid
  property      Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String?                 @db.Uuid
  room          Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reservationId String?                 @db.Uuid
  reservation   Reservation?            @relation("ReservationGuestServices", fields: [reservationId], references: [id], onDelete: SetNull)
  serviceCode   String?
  serviceDate   DateTime?               @db.Date
  serviceTime   String?
  type          OperationalTaskType
  status        OperationalTaskStatus   @default(OPEN)
  priority      OperationalTaskPriority @default(NORMAL)
  title         String
  description   String?
  assignedToId  String?                 @db.Uuid
  assignedTo    StaffUser?              @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByType String
  createdById   String?
  source        String?
  completedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([propertyId, status, type])
  @@index([roomId, status])
  @@index([reservationId, status])
  @@index([propertyId, serviceCode, status, serviceDate])
  @@index([assignedToId, status])
  @@map("operational_tasks")
}

model AutomationInboundEvent {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @db.Uuid
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source           String
  idempotencyKey   String
  eventType        String
  payloadJson      Json
  resultResource   String?
  resultResourceId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([propertyId, source, idempotencyKey])
  @@index([propertyId, eventType, createdAt])
  @@map("automation_inbound_events")
}

model CommunicationChannel {
  id                String                   @id @default(uuid()) @db.Uuid
  propertyId        String                   @db.Uuid
  property          Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code              String
  kind              CommunicationChannelKind
  displayName       String
  externalAccountId String?
  isActive          Boolean                  @default(true)
  metadata          Json?
  conversations     Conversation[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([propertyId, code])
  @@index([propertyId, kind, isActive])
  @@map("communication_channels")
}

model Conversation {
  id                     String               @id @default(uuid()) @db.Uuid
  propertyId             String               @db.Uuid
  property               Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channelId              String               @db.Uuid
  channel                CommunicationChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  externalConversationId String?
  externalContactId      String?
  contactName            String?
  contactPhone           String?
  contactUsername        String?
  status                 ConversationStatus   @default(OPEN)
  assignedToId           String?              @db.Uuid
  assignedTo             StaffUser?           @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reservationRequestId   String?              @db.Uuid
  reservationRequest     ReservationRequest?  @relation(fields: [reservationRequestId], references: [id], onDelete: SetNull)
  lastInboundAt          DateTime?
  lastOutboundAt         DateTime?
  firstResponseAt        DateTime?
  resolvedAt             DateTime?
  messages               ConversationMessage[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([channelId, externalConversationId])
  @@index([propertyId, status, updatedAt])
  @@index([assignedToId, status])
  @@index([reservationRequestId])
  @@map("conversations")
}

model ConversationMessage {
  id                String                @id @default(uuid()) @db.Uuid
  conversationId    String                @db.Uuid
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  externalMessageId String?
  senderType        String
  senderExternalId  String?
  text              String?
  contentType       String                @default("TEXT")
  deliveryStatus    MessageDeliveryStatus @default(UNKNOWN)
  rawPayload        Json?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model NfcWallet {
  id            String          @id @default(uuid()) @db.Uuid
  propertyId    String          @db.Uuid
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String          @unique @db.Uuid
  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestId       String          @db.Uuid
  guest         Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  balanceKgs    Int             @default(0)
  status        NfcWalletStatus @default(ACTIVE)
  bracelets     NfcBracelet[]
  transactions  NfcTransaction[]
  ledgerEntries NfcLedgerEntry[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([propertyId, status])
  @@index([guestId])
  @@map("nfc_wallets")
}

model NfcBracelet {
  id           String            @id @default(uuid()) @db.Uuid
  propertyId   String            @db.Uuid
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  walletId     String            @db.Uuid
  wallet       NfcWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  uidHash      String
  status       NfcBraceletStatus @default(ACTIVE)
  label        String?
  issuedAt     DateTime          @default(now())
  returnedAt   DateTime?
  transactions NfcTransaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([propertyId, uidHash])
  @@index([walletId, status])
  @@map("nfc_bracelets")
}

model NfcTransaction {
  id                 String               @id @default(uuid()) @db.Uuid
  propertyId         String               @db.Uuid
  property           Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  walletId           String               @db.Uuid
  wallet             NfcWallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  braceletId         String               @db.Uuid
  bracelet           NfcBracelet          @relation(fields: [braceletId], references: [id], onDelete: Restrict)
  partnerStaffUserId String               @db.Uuid
  partnerStaffUser   StaffUser            @relation("BeachPartnerTransactions", fields: [partnerStaffUserId], references: [id], onDelete: Restrict)
  amountKgs          Int
  hotelCommissionKgs Int
  partnerNetKgs      Int
  commissionBps      Int
  status             NfcTransactionStatus @default(COMPLETED)
  idempotencyKey     String
  description        String?
  externalRef        String?
  ledgerEntry        NfcLedgerEntry?
  createdAt          DateTime             @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([partnerStaffUserId, createdAt])
  @@map("nfc_transactions")
}

model NfcLedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  walletId         String          @db.Uuid
  wallet           NfcWallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transactionId    String?         @unique @db.Uuid
  transaction      NfcTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  entryType        String
  deltaKgs         Int
  balanceBeforeKgs Int
  balanceAfterKgs  Int
  note             String?
  createdAt        DateTime        @default(now())

  @@index([walletId, createdAt])
  @@map("nfc_ledger_entries")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id])
  actorType  String
  actorId    String?
  action     String
  resource   String
  resourceId String?
  source     String?
  result     String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime  @default(now())

  @@index([propertyId, createdAt])
  @@map("audit_logs")
}

model OwnerAnalyticsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  snapshotDate DateTime @db.Date
  horizonDays  Int
  payloadJson  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([propertyId, snapshotDate])
  @@index([propertyId, snapshotDate])
  @@map("owner_analytics_snapshots")
}

model GuestEngagement {
  id            String       @id @default(uuid()) @db.Uuid
  propertyId    String       @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId       String       @db.Uuid
  guest         Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?      @db.Uuid
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  kind          String
  status        String       @default("OPEN")
  dueDate       DateTime?    @db.Date
  channelHint   String?
  title         String
  notes         String?
  score         Int?
  feedbackText  String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId, status, dueDate])
  @@index([guestId, createdAt])
  @@index([reservationId])
  @@map("guest_engagements")
}

model GuestAccessCredential {
  id                  String         @id @db.Uuid
  propertyId          String         @db.Uuid
  property            Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId       String         @unique @db.Uuid
  reservation         Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  pinHash             String
  activationTokenHash String?
  isActive            Boolean        @default(true)
  expiresAt           DateTime       @db.Timestamptz(6)
  issuedAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  sessions            GuestSession[]

  @@index([propertyId, isActive, expiresAt], map: "guest_access_credentials_property_active_idx")
  @@map("guest_access_credentials")
}

model GuestSession {
  id                String             @id @db.Uuid
  credentialId      String             @db.Uuid
  credential        GuestAccessCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  tokenHash         String             @unique
  expiresAt         DateTime           @db.Timestamptz(6)
  revokedAt         DateTime?          @db.Timestamptz(6)
  lastSeenAt        DateTime           @default(now()) @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  smartAccessGrants SmartAccessGrant[]

  @@index([credentialId, expiresAt], map: "guest_sessions_credential_expires_idx")
  @@map("guest_sessions")
}

model ReservationMealPlan {
  id            String      @id @db.Uuid
  propertyId    String      @db.Uuid
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  serviceDate   DateTime    @db.Date
  mealType      String
  included      Boolean     @default(false)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([reservationId, serviceDate, mealType])
  @@index([propertyId, serviceDate, mealType], map: "reservation_meal_plans_property_date_idx")
  @@map("reservation_meal_plans")
}

model DiningMenuItem {
  id                 String            @id @db.Uuid
  propertyId         String            @db.Uuid
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  serviceDate        DateTime          @db.Date
  mealType           String
  name               String
  description        String?
  priceKgs           Int               @default(0)
  availableQty       Int?
  includedInMealPlan Boolean           @default(false)
  active             Boolean           @default(true)
  sortOrder          Int               @default(0)
  createdById        String?           @db.Uuid
  createdBy          StaffUser?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  orderItems         DiningOrderItem[]
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([propertyId, serviceDate, mealType, active, sortOrder], map: "dining_menu_items_property_date_idx")
  @@map("dining_menu_items")
}

model DiningOrder {
  id            String            @id @db.Uuid
  propertyId    String            @db.Uuid
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String            @db.Uuid
  reservation   Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  serviceDate   DateTime          @db.Date
  mealType      String
  status        String            @default("NEW")
  paymentMode   String            @default("ROOM_FOLIO")
  totalKgs      Int               @default(0)
  notes         String?
  items         DiningOrderItem[]
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  completedAt   DateTime?         @db.Timestamptz(6)

  @@index([propertyId, status, serviceDate, mealType], map: "dining_orders_property_status_idx")
  @@index([reservationId, createdAt], map: "dining_orders_reservation_idx")
  @@map("dining_orders")
}

model DiningOrderItem {
  id             String         @id @db.Uuid
  orderId        String         @db.Uuid
  order          DiningOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String         @db.Uuid
  menuItem       DiningMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  name           String
  quantity       Int
  unitPriceKgs   Int
  lineTotalKgs   Int
  includedByPlan Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  @@index([orderId], map: "dining_order_items_order_idx")
  @@map("dining_order_items")
}

model ReservationCharge {
  id            String       @id @db.Uuid
  propertyId    String       @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String       @db.Uuid
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  sourceType    String
  sourceId      String?      @db.Uuid
  description   String
  amountKgs     Int
  status        String       @default("OPEN")
  paymentId     String?      @db.Uuid
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  paidAt        DateTime?    @db.Timestamptz(6)

  // sourceType/sourceId is protected by a partial unique index in migration 5;
  // Prisma cannot model the WHERE sourceId IS NOT NULL predicate without changing semantics.
  @@index([reservationId, status, createdAt], map: "reservation_charges_reservation_status_idx")
  @@map("reservation_charges")
}

model SmartAccessPoint {
  id                   String                      @id @db.Uuid
  propertyId           String                      @db.Uuid
  property             Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  kind                 String
  roomId               String?                     @db.Uuid
  room                 Room?                       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  priceKgs             Int                         @default(0)
  active               Boolean                     @default(false)
  controllerRef        String?
  grants               SmartAccessGrant[]
  publicPaymentIntents PublicAccessPaymentIntent[]
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, code])
  @@index([roomId, active], map: "smart_access_points_room_idx")
  @@map("smart_access_points")
}

model SmartAccessGrant {
  id             String            @id @db.Uuid
  propertyId     String            @db.Uuid
  property       Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  accessPointId  String            @db.Uuid
  accessPoint    SmartAccessPoint  @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  reservationId  String?           @db.Uuid
  reservation    Reservation?      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestSessionId String?           @db.Uuid
  guestSession   GuestSession?     @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  paymentId      String?           @db.Uuid
  payment        Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  tokenHash      String            @unique
  status         String            @default("ISSUED")
  expiresAt      DateTime          @db.Timestamptz(6)
  usedAt         DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  @@index([accessPointId, status, expiresAt], map: "smart_access_grants_point_status_idx")
  @@map("smart_access_grants")
}

model PublicAccessPaymentIntent {
  id            String           @id @db.Uuid
  propertyId    String           @db.Uuid
  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  accessPointId String           @db.Uuid
  accessPoint   SmartAccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  tokenHash     String           @unique
  amountKgs     Int
  status        String           @default("PENDING")
  provider      String?
  externalRef   String?
  expiresAt     DateTime         @db.Timestamptz(6)
  paidAt        DateTime?        @db.Timestamptz(6)
  usedAt        DateTime?        @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  // provider/externalRef is protected by a partial unique index in migration 6;
  // Prisma intentionally does not model it as an unconditional @@unique.
  @@index([accessPointId, status, expiresAt], map: "public_access_payment_intents_point_status_idx")
  @@map("public_access_payment_intents")
}
