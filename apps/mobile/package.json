{
  "name": "@marina-smart/mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "web:export": "expo export --platform web",
    "postweb:export": "node scripts/qa-web-visual.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "i18next": "^26.7.1",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|expo-router|standard-navigation|@standard-navigation/.*|react-native-.*))"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  },
  "overrides": {
    "@expo/cli": {
      "glob": "^14.0.2"
    },
    "@expo/config": {
      "glob": "^14.0.2"
    },
    "@expo/config-plugins": {
      "glob": "^14.0.2"
    },
    "@expo/fingerprint": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    },
    "@expo/metro-config": {
      "glob": "^14.0.2"
    },
    "@jest/core": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.1"
    },
    "@jest/reporters": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.1"
    },
    "test-exclude": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.1"
    },
    "jest-config": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.1"
    },
    "jest-runtime": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.1"
    },
    "babel-plugin-istanbul": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.1"
    }
  }
}
