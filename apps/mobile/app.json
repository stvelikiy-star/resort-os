{
  "expo": {
    "name": "MARINA SMART STAFF",
    "slug": "marina-staff",
    "scheme": "marinastaff",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "environment": "development"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите MARINA SMART сканировать QR-коды гостиниц",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
